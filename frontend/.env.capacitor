# Loaded only by `vite build --mode capacitor` (npm run build:apk).
# The packaged Android app has no backend on its own origin, so point it
# at the deployed GammaTerminal backend. Change these if the server moves
# or once it has a domain + HTTPS (then use https:// and wss://).
VITE_API_BASE=https://gammaterminal.in
VITE_WS_BASE=wss://gammaterminal.in
