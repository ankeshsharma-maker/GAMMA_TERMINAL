# --- market data source ---
# "nse" (default) or "upstox". Upstox also covers BSE/BFO (SENSEX, BANKEX).
# Orders are unaffected - they always route through BROKER (Flattrade).
DATA_SOURCE=nse
# Easiest: paste the 1-year "Analytics Access Token" from the Upstox developer
# console (read-only, market-data). No daily login, no OAuth.
UPSTOX_ACCESS_TOKEN=
# Only for the alternative interactive daily OAuth (not needed with the token above):
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URL=http://127.0.0.1:8000/api/upstox/callback

# --- app security ---
# Set a password to lock the whole API. Unset/empty = wide open (default).
# The frontend shows a login screen; every /api call and the /ws socket then
# needs the token it hands back. Use a long random string.
APP_PASSWORD=

# --- pricing / poller ---
RISK_FREE_RATE=0.065
DIVIDEND_YIELD=0.0
POLL_INTERVAL=15
OFFHOURS_POLL_INTERVAL=60
DEFAULT_SYMBOLS=NIFTY,BANKNIFTY,FINNIFTY
STRIKE_WINDOW=30

# --- cross-symbol screener ---
SCREENER_STAGGER=2.5
# SCREENER_SYMBOLS=NIFTY,BANKNIFTY,RELIANCE,...   (override the built-in F&O list)

# --- Flattrade broker (real-time ticks + real candles, later live orders) ---
# 1. Create an API app at https://wall.flattrade.in  (Pi -> API Key)
# 2. Set its Redirect URL to EXACTLY the value of FLATTRADE_REDIRECT_URL below:
#      local dev  -> http://127.0.0.1:8000/api/broker/callback
#      OCI server -> http://<public-ip>/api/broker/callback     (port 80, via nginx)
#      with a domain + TLS -> https://terminal.yourdomain.com/api/broker/callback
# 3. Fill these in and restart the backend, then click "Connect Flattrade" in the header.
BROKER=flattrade
FLATTRADE_API_KEY=
FLATTRADE_API_SECRET=
FLATTRADE_CLIENT_ID=
FLATTRADE_REDIRECT_URL=http://127.0.0.1:8000/api/broker/callback
