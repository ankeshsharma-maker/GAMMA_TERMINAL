# --- pricing / poller ---
RISK_FREE_RATE=0.065
DIVIDEND_YIELD=0.0
POLL_INTERVAL=15
OFFHOURS_POLL_INTERVAL=60
DEFAULT_SYMBOLS=NIFTY,BANKNIFTY,FINNIFTY
STRIKE_WINDOW=30

# --- cross-symbol screener ---
SCREENER_STAGGER=2.5
# SCREENER_SYMBOLS=NIFTY,BANKNIFTY,RELIANCE,...   (override the built-in F&O list)

# --- Flattrade broker (real-time ticks + real candles, later live orders) ---
# 1. Create an API app at https://wall.flattrade.in  (Pi -> API Key)
# 2. Set its Redirect URL to EXACTLY the value of FLATTRADE_REDIRECT_URL below:
#      local dev  -> http://127.0.0.1:8000/api/broker/callback
#      OCI server -> http://<public-ip>/api/broker/callback     (port 80, via nginx)
#      with a domain + TLS -> https://terminal.yourdomain.com/api/broker/callback
# 3. Fill these in and restart the backend, then click "Connect Flattrade" in the header.
BROKER=flattrade
FLATTRADE_API_KEY=
FLATTRADE_API_SECRET=
FLATTRADE_CLIENT_ID=
FLATTRADE_REDIRECT_URL=http://127.0.0.1:8000/api/broker/callback
